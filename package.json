{
  "name": "sandpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sandpilot": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "docker:build": "docker build -t sandpilot-codex:latest -f docker/Dockerfile.codex .",
    "docker:doctor": "docker run --rm sandpilot-codex:latest bash /opt/sandpilot/sandbox-doctor.sh",
    "start:daemon": "bun run src/cli/index.ts daemon start",
    "doctor": "bun run src/cli/index.ts daemon doctor"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
